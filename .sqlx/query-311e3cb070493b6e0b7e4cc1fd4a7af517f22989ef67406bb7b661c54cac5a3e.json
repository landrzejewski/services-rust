  "query": "\n        SELECT id, room_id, user_id, start_time, end_time, attendees, status, created_at\n        FROM bookings\n        WHERE room_id = $1 AND status = 'ACTIVE'\n          AND start_time < $3 AND end_time > $2\n        ORDER BY start_time\n        ",
