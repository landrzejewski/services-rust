  "db_name": "PostgreSQL",
  "query": "\n            SELECT id, room_id, user_id, start_time, end_time, attendees, status, created_at\n            FROM bookings\n            WHERE ($1::uuid IS NULL OR room_id = $1)\n              AND ($2::uuid IS NULL OR user_id = $2)\n              AND ($3::text IS NULL OR status = $3)\n            ORDER BY start_time, id\n            LIMIT $4 OFFSET $5\n            ",
