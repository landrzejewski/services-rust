  "query": "\n            SELECT id, name, description, capacity, opens_at, closes_at\n            FROM rooms\n            WHERE ($1::int4 IS NULL OR capacity >= $1)\n              AND ($2::text IS NULL OR name ILIKE $2)\n            ORDER BY id\n            LIMIT $3 OFFSET $4\n            ",
