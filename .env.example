# Copy to `.env` (git-ignored) and adjust: `cp .env.example .env`
# Values from the real environment always win over values from `.env`.

# Selects config/<APP_ENVIRONMENT>.toml on top of config/default.toml.
APP_ENVIRONMENT=local

# Any config key can be overridden: APP_<SECTION>__<KEY>
# APP_SERVER__PORT=3000
# APP_RUNTIME__WORKER_THREADS=2

# Log filter for the `tracing` crate: global level and per-crate levels.
RUST_LOG=info,rust_services=debug

# PostgreSQL connection (used from step 014; matches compose.yaml).
DATABASE_URL=postgres://booking:booking@localhost:5432/booking
