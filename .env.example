# Copy to `.env` (git-ignored) and adjust: `cp .env.example .env`
# Values from the real environment always win over values from `.env`.

# Selects config/<APP_ENVIRONMENT>.toml on top of config/default.toml.
APP_ENVIRONMENT=local

# Any config key can be overridden: APP_<SECTION>__<KEY>
# APP_SERVER__PORT=3000
# APP_RUNTIME__WORKER_THREADS=2

# HMAC key for signing access tokens (step 019). Generate a real one: `openssl rand -base64 48`.
# Development value only – never reuse it in any shared environment.
APP_AUTH__JWT_SECRET=dev-only-secret-change-me-0123456789abcdef

# Log filter for the `tracing` crate: global level and per-crate levels.
RUST_LOG=info,rust_services=debug

# Export traces to Jaeger from compose.yaml (step 023); UI: http://localhost:16686
# APP_TELEMETRY__OTLP_ENDPOINT=http://localhost:4318
# Structured JSON logs instead of pretty ones:
# APP_TELEMETRY__LOG_FORMAT=json

# PostgreSQL connection (used from step 014; matches compose.yaml).
# Also read by sqlx macros at COMPILE time to check queries against the live schema (step 015).
DATABASE_URL=postgres://booking:booking@localhost:5432/booking

# Compile without a database using the committed `.sqlx/` metadata (CI, Docker builds).
# Regenerate after changing queries: `cargo sqlx prepare -- --all-targets`
# SQLX_OFFLINE=true
